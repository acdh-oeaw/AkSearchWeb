# Copy to .env.vufind10 and replace secrets before starting the local stack.
COMPOSE_PROJECT_NAME=aksearch-vufind10
AKSEARCH_WEB_PORT=8081
AKSEARCH_DIRECT_WEB_PORT=8082
MYSQL_ROOT_PASSWORD=local-root-change-me
DB_USER=vufind
DB_NAME=vufind
DB_PASSWORD=local-vufind-change-me
ALMA_KEY=replace-with-a-test-alma-key
SITE_URL=http://localhost:8081
DEGRUYTER_USER=replace-with-degruyter-username
DEGRUYTER_PASSWORD=replace-with-degruyter-password
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,solr,mariadb
ANUBIS_PRIVATE_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
